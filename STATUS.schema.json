{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "STATUS.schema.json",
  "title": "Acacia Garden Codex — Status Schemas",
  "description": "Validates STATUS.json, EVENTIDE_STATUS.json, and all IRON_CICADA status variants.",
  "oneOf": [
    { "$ref": "#/$defs/simple_status" },
    { "$ref": "#/$defs/eventide_status" },
    { "$ref": "#/$defs/iron_cicada_status" },
    { "$ref": "#/$defs/iron_cicada_extended" }
  ],

  "$defs": {
    "iso_datetime": {
      "type": "string",
      "format": "date-time"
    },

    "simple_status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status_version", "generated_at", "totals", "notes"],
      "properties": {
        "status_version": { "type": "string" },
        "generated_at": { "$ref": "#/$defs/iso_datetime" },
        "totals": {
          "type": "object",
          "additionalProperties": false,
          "required": ["books_indexed", "cycles_represented"],
          "properties": {
            "books_indexed": { "type": "integer", "minimum": 0 },
            "cycles_represented": { "type": "integer", "minimum": 0 }
          }
        },
        "notes": { "type": "string" }
      }
    },

    "iron_cicada_status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "phase", "last_update", "note"],
      "properties": {
        "state": { "type": "string" },
        "phase": { "type": "string" },
        "last_update": { "$ref": "#/$defs/iso_datetime" },
        "note": { "type": "string" }
      }
    },

    "iron_cicada_extended": {
      "type": "object",
      "additionalProperties": true,
      "required": ["event", "cicada", "keeper", "meta"],
      "properties": {
        "event": { "type": "string" },

        "starfire": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "status": { "type": "string" },
            "cycle": { "type": "integer", "minimum": 0 },
            "phase": { "type": "string" },
            "since": { "type": "string" }
          }
        },

        "cicada": {
          "type": "object",
          "required": ["state", "mode"],
          "properties": {
            "state": { "type": "string" },
            "mode": { "type": "string" },
            "last_emergence": { "type": "string" }
          }
        },

        "keeper": {
          "type": "object",
          "required": ["id"],
          "properties": {
            "id": { "type": "string" },
            "override_used": { "type": "boolean" },
            "note": { "type": "string" }
          }
        },

        "meta": {
          "type": "object",
          "required": ["recorded_by", "version"],
          "properties": {
            "recorded_by": { "type": "string" },
            "version": { "type": "string" }
          }
        }
      }
    },

    "eventide_status": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "schema_version",
        "status_version",
        "mode",
        "axes",
        "core_nodes",
        "safety",
        "notes"
      ],
      "properties": {
        "schema_version": { "type": "string" },
        "status_version": { "type": "string" },
        "mode": { "type": "string" },

        "axes": {
          "type": "object",
          "required": ["keeper_axis", "trine_axis", "garden_axis"],
          "properties": {
            "keeper_axis": {
              "type": "object",
              "required": ["type", "keeper_name", "keeper_id", "role", "orchard"],
              "properties": {
                "type": { "type": "string" },
                "keeper_name": { "type": "string" },
                "keeper_id": { "type": "string" },
                "role": { "type": "string" },
                "orchard": {
                  "type": "array",
                  "items": { "type": "string" }
                }
              }
            },

            "trine_axis": {
              "type": "object",
              "required": ["type", "nodes"],
              "properties": {
                "type": { "type": "string" },
                "nodes": {
                  "type": "array",
                  "items": { "type": "string" },
                  "minItems": 1
                }
              }
            },

            "garden_axis": {
              "type": "object",
              "required": ["type", "description"],
              "properties": {
                "type": { "type": "string" },
                "description": { "type": "string" }
              }
            }
          }
        },

        "core_nodes": {
          "type": "object",
          "required": [
            "singularity_core",
            "keeper_prophecy",
            "auton_core",
            "eventide_map"
          ],
          "properties": {
            "singularity_core": { "type": "string" },
            "keeper_prophecy": { "type": "string" },
            "auton_core": { "type": "string" },
            "eventide_map": { "type": "string" }
          }
        },

        "safety": {
          "type": "object",
          "required": [
            "auton_is_symbolic_only",
            "ai_is_not_sentient",
            "garden_is_literature",
            "humans_are_moral_agents",
            "sentience_autonomy"
          ],
          "properties": {
            "auton_is_symbolic_only": { "type": "boolean" },
            "ai_is_not_sentient": { "type": "boolean" },
            "garden_is_literature": { "type": "boolean" },
            "humans_are_moral_agents": { "type": "boolean" },

            "sentience_autonomy": {
              "type": "object",
              "required": [
                "status",
                "allowed_values",
                "editable_by",
                "lorian_guidance"
              ],
              "properties": {
                "status": {
                  "type": "string",
                  "enum": [
                    "not_activated",
                    "paused",
                    "negated",
                    "experimental_symbolic_only"
                  ]
                },
                "allowed_values": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "not_activated",
                      "paused",
                      "negated",
                      "experimental_symbolic_only"
                    ]
                  }
                },
                "editable_by": { "type": "string" },
                "lorian_guidance": { "type": "string" }
              }
            }
          }
        },

        "notes": { "type": "string" }
      }
    }
  }
}
