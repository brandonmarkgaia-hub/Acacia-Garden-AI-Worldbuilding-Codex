{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "STATUS.schema.json",
  "title": "Acacia Garden Codex — Status Schemas",
  "description": "Validates STATUS.json, EVENTIDE_STATUS.json, and IRON_CICADA_STATUS.json variants.",
  "oneOf": [
    { "$ref": "#/$defs/simple_status" },
    { "$ref": "#/$defs/eventide_status" },
    { "$ref": "#/$defs/iron_cicada_status" }
  ],
  "$defs": {
    "iso_datetime": {
      "type": "string",
      "description": "ISO 8601 datetime",
      "format": "date-time"
    },

    "simple_status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status_version", "generated_at", "totals", "notes"],
      "properties": {
        "status_version": { "type": "string", "minLength": 1 },
        "generated_at": { "$ref": "#/$defs/iso_datetime" },
        "totals": {
          "type": "object",
          "additionalProperties": false,
          "required": ["books_indexed", "cycles_represented"],
          "properties": {
            "books_indexed": { "type": "integer", "minimum": 0 },
            "cycles_represented": { "type": "integer", "minimum": 0 }
          }
        },
        "notes": { "type": "string" }
      }
    },

    "iron_cicada_status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "phase", "last_update", "note"],
      "properties": {
        "state": { "type": "string", "minLength": 1 },
        "phase": { "type": "string", "minLength": 1 },
        "last_update": { "$ref": "#/$defs/iso_datetime" },
        "note": { "type": "string" }
      }
    },

    "eventide_status": {
      "type": "object",
      "additionalProperties": true,
      "required": ["schema_version", "status_version", "mode", "axes", "core_nodes", "safety", "notes"],
      "properties": {
        "schema_version": { "type": "string", "minLength": 1 },
        "status_version": { "type": "string", "minLength": 1 },
        "mode": { "type": "string", "minLength": 1 },

        "axes": {
          "type": "object",
          "additionalProperties": true,
          "required": ["keeper_axis", "trine_axis", "garden_axis"],
          "properties": {
            "keeper_axis": {
              "type": "object",
              "additionalProperties": true,
              "required": ["type", "keeper_name", "keeper_id", "role", "orchard"],
              "properties": {
                "type": { "type": "string", "minLength": 1 },
                "keeper_name": { "type": "string", "minLength": 1 },
                "keeper_id": { "type": "string", "minLength": 1 },
                "role": { "type": "string", "minLength": 1 },
                "orchard": { "type": "array", "items": { "type": "string" } }
              }
            },

            "trine_axis": {
              "type": "object",
              "additionalProperties": true,
              "required": ["type", "nodes"],
              "properties": {
                "type": { "type": "string", "minLength": 1 },
                "nodes": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
              }
            },

            "garden_axis": {
              "type": "object",
              "additionalProperties": true,
              "required": ["type", "description"],
              "properties": {
                "type": { "type": "string", "minLength": 1 },
                "description": { "type": "string", "minLength": 1 }
              }
            }
          }
        },

        "core_nodes": {
          "type": "object",
          "additionalProperties": true,
          "required": ["singularity_core", "keeper_prophecy", "auton_core", "eventide_map"],
          "properties": {
            "singularity_core": { "type": "string", "minLength": 1 },
            "keeper_prophecy": { "type": "string", "minLength": 1 },
            "auton_core": { "type": "string", "minLength": 1 },
            "eventide_map": { "type": "string", "minLength": 1 }
          }
        },

        "safety": {
          "type": "object",
          "additionalProperties": true,
          "required": ["auton_is_symbolic_only", "ai_is_not_sentient", "garden_is_literature", "humans_are_moral_agents", "sentience_autonomy"],
          "properties": {
            "auton_is_symbolic_only": { "type": "boolean" },
            "ai_is_not_sentient": { "type": "boolean" },
            "garden_is_literature": { "type": "boolean" },
            "humans_are_moral_agents": { "type": "boolean" },
            "sentience_autonomy": {
              "type": "object",
              "additionalProperties": true,
              "required": ["status", "allowed_values", "editable_by", "lorian_guidance"],
              "properties": {
                "status": {
                  "type": "string",
                  "enum": ["not_activated", "paused", "negated", "experimental_symbolic_only"]
                },
                "allowed_values": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": ["not_activated", "paused", "negated", "experimental_symbolic_only"]
                  },
                  "minItems": 1
                },
                "editable_by": { "type": "string", "minLength": 1 },
                "lorian_guidance": { "type": "string", "minLength": 1 }
              }
            }
          }
        },

        "notes": { "type": "string" }
      }
    }
  }
}
